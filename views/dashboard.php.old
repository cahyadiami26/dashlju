<?php
/**
 * View Dashboard App Selector - Clean & Elegant Theme
 * File: views/dashboard.php
 */
require_once __DIR__ . '/../config/session.php';
require_once __DIR__ . '/../config/database.php'; // Memuat konstanta BIDANG, DIVISI, POSITIONS[cite: 1]
require_once __DIR__ . '/../config/apps.php'; 

// Mengambil data user dari fungsi session yang diperbarui[cite: 1]
$user = getSessionUser();

// Path file media berdasarkan struktur folder /dms.lju.co.id/[cite: 1]
$avatarUrl = !empty($user['avatar']) ? 'https://dms.lju.co.id/uploads/avatars/' . htmlspecialchars($user['avatar']) : '';
$photoUrl = !empty($user['photo']) ? 'https://dms.lju.co.id/uploads/photos/' . htmlspecialchars($user['photo']) : '';
$sigUrl = !empty($user['signature']) ? 'https://dms.lju.co.id/uploads/signatures/' . htmlspecialchars($user['signature']) : '';

$email = $user['webmail_user'] ?? ($user['email'] ?? '');
$apps = getAppsConfig();

$userDiv  = strtolower($user['division'] ?? '');
$userDept = strtolower($user['department'] ?? '');
$userRole = strtolower($user['role'] ?? '');

$isInfokom = ($userDiv === 'infokom');
$isDireksi = ($userDiv === 'direksi' || $userDept === 'direksi' || $userRole === 'admin');
$jumlahUserOnline = getActiveUserCount();
//echo var_dump($_SESSION);
?>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>App Selector - LJU Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #1e40af;
            --primary-teal: #14b8a6;
            --text-dark: #0f172a;
            --text-gray: #64748b;
            --bg-body: #f8fafc;
            --bg-card: #ffffff;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            color: var(--text-dark);
            background-color: #f0fdfa;
            background-image: 
                radial-gradient(at 0% 0%, hsla(186,100%,86%,1) 0, transparent 50%), 
                radial-gradient(at 100% 0%, hsla(199,89%,48%,1) 0, transparent 50%), 
                radial-gradient(at 100% 100%, hsla(173,80%,40%,1) 0, transparent 50%),
                radial-gradient(at 0% 100%, hsla(217,100%,45%,0.8) 0, transparent 50%);
            background-attachment: fixed;
        }

        /* Navbar */
        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            position: sticky;
            top: 0;
            z-index: 50;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 64px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            max-height: 40px;
        }

        .brand img, .brand-logo {
            display: block;
            height: 36px;
            width: auto;
            max-width: 160px;
            object-fit: contain;
            object-position: left center;
        }

        .brand-text {
            font-size: 18px;
            font-weight: 800;
            color: var(--primary-blue);
            letter-spacing: -0.5px;
            white-space: nowrap;
        }

        .brand-text span {
            color: var(--primary-teal);
        }

        .user-nav {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-meta { text-align: right; display: none; }
        @media(min-width: 600px) { .user-meta { display: block; } }

        .user-meta .name { font-size: 14px; font-weight: 700; color: var(--text-dark); line-height: 1.2; }
        .user-meta .role { font-size: 12px; color: var(--text-gray); font-weight: 500; line-height: 1.2; }

        .user-avatar-container {
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: transform 0.2s;
        }
        .user-avatar-container:hover {
            transform: scale(1.05);
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-teal));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 15px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(20, 184, 166, 0.25);
            position: relative;
        }

        .user-avatar img { 
            position: absolute;
            top: 0;
            left: 0;
            width: 100%; 
            height: 100%; 
            object-fit: cover; 
            z-index: 2;
        }

        .user-avatar span {
            position: relative;
            z-index: 1;
        }

        .btn-logout {
            background: #fef2f2;
            color: #ef4444;
            border: 1px solid #fee2e2;
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .btn-logout:hover {
            background: #ef4444;
            color: white;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
        }

        .btn-logout svg { width: 16px; height: 16px; flex-shrink: 0; }

        @media (max-width: 600px) {
            .nav-container { padding: 10px 16px; height: 56px; }
            .brand img, .brand-logo { height: 30px; max-width: 120px; }
            .btn-logout .logout-text { display: none; }
            .user-avatar { width: 36px; height: 36px; min-width: 36px; font-size: 14px; }
        }

        /* Container Main */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 50px 24px;
        }

        .hero { margin-bottom: 40px; text-align: center; }
        .hero h1 { font-size: 32px; font-weight: 800; color: var(--text-dark); margin-bottom: 10px; letter-spacing: -0.5px; }
        .hero p { color: var(--text-gray); font-size: 16px; font-weight: 500; margin-bottom: 20px; }

        /* Online Users Badge */
        .online-users-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(20, 184, 166, 0.25);
            padding: 8px 18px;
            border-radius: 50px;
            box-shadow: 0 4px 15px rgba(20, 184, 166, 0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .online-users-badge:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(20, 184, 166, 0.15);
        }

        .pulse-dot {
            position: relative;
            width: 10px;
            height: 10px;
            background-color: #10b981;
            border-radius: 50%;
            display: inline-block;
        }

        .pulse-dot::after {
            content: '';
            position: absolute;
            top: -3px;
            left: -3px;
            right: -3px;
            bottom: -3px;
            border: 2px solid #10b981;
            border-radius: 50%;
            animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }

        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.6); opacity: 0; }
            100% { transform: scale(0.95); opacity: 0; }
        }

        .online-users-text {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-dark);
            letter-spacing: -0.2px;
        }

        .online-users-text strong {
            color: var(--primary-blue);
            font-weight: 800;
        }

/* Floating Button Presensi Online */
        .floating-attendance-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8); /* Menggunakan warna Biru Royal Profesional */
            color: #ffffff;
            padding: 14px 24px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4); /* Disesuaikan dengan warna biru */
            z-index: 999;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 2px solid rgba(255, 255, 255, 0.25);
        }

        .floating-attendance-btn:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 15px 30px rgba(37, 99, 235, 0.6);
            background: linear-gradient(135deg, #1d4ed8, #1e40af);
            color: #ffffff;
        }

        .floating-attendance-btn i {
            font-size: 16px;
        }

        .floating-attendance-btn svg {
            width: 20px;
            height: 20px;
            animation: pulse-icon 2s infinite;
        }

        @keyframes pulse-icon {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }

        @media (max-width: 600px) {
            .floating-attendance-btn {
                bottom: 20px;
                right: 20px;
                padding: 10px 16px;
                font-size: 13px;
            }
            .floating-attendance-btn span.btn-label {
                display: none; /* Sembunyikan teks di layar HP kecil agar menjadi icon button */
            }
            .floating-attendance-btn {
                padding: 12px;
                border-radius: 50%;
            }
        }

        /* Grid Aplikasi */
        .apps-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 24px;
        }

        /* Card Aplikasi */
        .app-card {
            background: var(--bg-card);
            border: 1px solid #f1f5f9;
            border-radius: 20px;
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 20px;
            text-decoration: none;
            color: inherit;
            position: relative;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        }

        .app-card.active { cursor: pointer; }
        .app-card.active:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 40px -10px rgba(var(--card-rgb), 0.15);
            border-color: var(--card-color);
        }

        .app-card.inactive {
            opacity: 0.6;
            cursor: not-allowed;
            pointer-events: none;
            background: #f8fafc;
            box-shadow: none;
        }

        .app-card.forbidden {
            opacity: 0.8;
            cursor: not-allowed;
            pointer-events: none;
            background: #fafafa;
            border-color: #f1f5f9;
            box-shadow: none;
        }
        
        .app-card.forbidden .app-icon-wrapper {
            filter: grayscale(100%);
            opacity: 0.6;
        }

        /* Badges */
        .badge {
            position: absolute;
            top: 16px;
            right: 16px;
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 8px;
            font-weight: 700;
        }

        .badge-inactive { background: #e2e8f0; color: #64748b; }
        
        .badge-forbidden { 
            background: #fef2f2; 
            color: #ef4444; 
            border: 1px solid #fee2e2;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Icon Wrapper */
        .app-icon-wrapper {
            width: 68px;
            height: 68px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            flex-shrink: 0;
            transition: transform 0.3s ease;
        }

        .app-card.active:hover .app-icon-wrapper { transform: scale(1.05); }
        .app-icon-wrapper img { width: 40px; height: 40px; object-fit: contain; }

        /* Info Teks */
        .app-details { flex: 1; }
        .app-details h3 { font-size: 18px; font-weight: 800; color: var(--text-dark); margin-bottom: 4px; letter-spacing: -0.3px; }
        .app-details p { font-size: 13px; color: var(--text-gray); line-height: 1.5; margin-bottom: 8px; font-weight: 500; }
        
        .app-url {
            font-size: 12px;
            font-weight: 700;
            color: var(--card-color);
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .app-card.active .app-url::after {
            content: '→'; opacity: 0; transform: translateX(-5px); transition: all 0.3s;
        }
        .app-card.active:hover .app-url::after {
            opacity: 1; transform: translateX(0);
        }
        
        .app-card.inactive .app-url,
        .app-card.forbidden .app-url {
            color: #94a3b8;
        }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            padding: 16px;
        }
        .modal-overlay.active { display: flex; }
        
        .modal-container {
            background: white;
            width: 100%;
            max-width: 800px;
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            animation: modalSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            max-height: 90vh;
            display: flex;
            flex-direction: column;
        }
        @keyframes modalSlideUp {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
        }
        .modal-header h3 { font-size: 16px; font-weight: 700; color: var(--text-dark); }
        
        .modal-close {
            background: #f1f5f9; border: none; width: 32px; height: 32px; border-radius: 50%;
            cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--text-gray);
            font-weight: bold; transition: background 0.2s;
        }
        .modal-close:hover { background: #e2e8f0; color: var(--text-dark); }

        .modal-body {
            padding: 20px;
            overflow-y: auto;
            flex: 1;
            -webkit-overflow-scrolling: touch;
        }

        /* View Profile Styling */
        .profile-view-content {
            text-align: center;
        }
        .profile-avatar-large {
            width: 84px;
            height: 84px;
            border-radius: 50%;
            margin: 0 auto 10px auto;
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-teal));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 30px;
            overflow: hidden;
            box-shadow: 0 6px 15px rgba(20, 184, 166, 0.25);
            position: relative;
        }
        .profile-avatar-large img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .profile-username {
            font-size: 14px;
            color: var(--text-gray);
            font-weight: 600;
            margin-bottom: 2px;
        }
        .profile-fullname {
            font-size: 18px;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 4px;
        }
        .profile-subtitle-meta {
            font-size: 13px;
            color: var(--primary-blue);
            font-weight: 700;
            margin-bottom: 16px;
        }
        .profile-section-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-dark);
            text-align: left;
            margin: 16px 0 8px 0;
        }
        .info-card-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .info-card-item {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-align: left;
        }
        .info-card-icon {
            font-size: 16px;
            color: var(--primary-teal);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .info-card-detail {
            display: flex;
            flex-direction: column;
        }
        .info-card-label {
            font-size: 10px;
            color: var(--text-gray);
            font-weight: 600;
        }
        .info-card-val {
            font-size: 13px;
            color: var(--text-dark);
            font-weight: 700;
        }

        /* Edit Profile Content (Grid 2 Kolom agar tidak terlalu panjang ke bawah) */
        .profile-edit-content {
            display: none;
        }
        .edit-grid-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        @media(max-width: 768px) {
            .edit-grid-layout {
                grid-template-columns: 1fr;
            }
        }
        
        .section-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 14px;
            margin-bottom: 0;
        }
        .section-box h4 {
            font-size: 12px;
            font-weight: 700;
            color: var(--primary-blue);
            margin-bottom: 10px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 6px;
        }

        .form-group {
            margin-bottom: 10px;
        }
        .form-group label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 3px;
        }
        .form-group input {
            width: 100%;
            padding: 8px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 13px;
            font-family: inherit;
            color: var(--text-dark);
            background-color: #fff;
        }
        .form-group input:focus {
            outline: none;
            border-color: var(--primary-teal);
            box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.15);
        }

        .upload-group {
            background: white;
            border: 1px dashed #cbd5e1;
            padding: 8px;
            border-radius: 8px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .upload-preview-thumb {
            width: 36px;
            height: 36px;
            border-radius: 6px;
            object-fit: cover;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 8px;
            color: #94a3b8;
            text-align: center;
        }
        .upload-preview-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 6px;
        }
        .upload-input-wrap {
            flex: 1;
            min-width: 0;
        }
        .upload-input-wrap label {
            font-size: 10px;
            color: var(--text-gray);
            margin-bottom: 1px;
            display: block;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .upload-input-wrap input[type="file"] {
            font-size: 9px;
            border: none;
            padding: 0;
            background: transparent;
            width: 100%;
        }

        .modal-footer {
            padding: 12px 20px;
            border-top: 1px solid #f1f5f9;
            background: #f8fafc;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-shrink: 0;
        }
        .btn {
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
        }
        .btn-secondary {
            background: #e2e8f0;
            color: var(--text-dark);
        }
        .btn-secondary:hover { background: #cbd5e1; }
        .btn-primary {
            background: var(--primary-blue);
            color: white;
        }
        .btn-primary:hover { background: #1d4ed8; }

        @media (max-width: 480px) {
            .modal-footer {
                flex-direction: column-reverse;
            }
            .modal-footer .btn {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>
<body>

<nav class="navbar">
