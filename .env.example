# ============================================================
# CONTOH FILE ENVIRONMENT — dashlju (Portal SSO Login)
# Salin file ini menjadi ".env" lalu isi nilainya:
#   cp .env.example .env
# JANGAN commit file .env yang berisi kredensial asli!
# ============================================================

# ---------- Google OAuth 2.0 (Login with Google) ----------
# Diambil dari Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# Opsional: HARUS SAMA PERSIS dengan Authorized redirect URI di Cloud Console
GOOGLE_REDIRECT_URI=https://lju.co.id/dashboard/google_callback.php

# ---------- URL Portal ----------
APP_URL_PORTAL=https://lju.co.id/dashboard

# ---------- Database (MySQL) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ljucoid_dms
DB_USER=ljucoid_dms
DB_PASS=ganti_dengan_password_db
