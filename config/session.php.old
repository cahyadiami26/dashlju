<?php
/**
 * Konfigurasi Session Bersama & Sinkronisasi Database
 * File: config/session.php
 */

if (headers_sent($file, $line)) {
    die("Headers sudah terkirim di $file baris $line. Session tidak bisa dimulai.");
}

session_name('LJU_APPS');
ini_set('session.cookie_domain', '.lju.co.id');

session_set_cookie_params([
    'lifetime' => 86400,
    'path'     => '/',
    'domain'   => '.lju.co.id',
    'secure'   => isset($_SERVER['HTTPS']),
    'httponly' => true,
    'samesite' => 'Lax'
]);

if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

// ====================================================================
// FITUR SESSION TIMEOUT (INAKTIVITAS & AUTO LOGOUT LOG)
// ====================================================================
define('INACTIVITY_TIMEOUT', 1800); // 1800 detik = 30 Menit

function checkSessionTimeout(): void
{
    if (!empty($_SESSION['user_id'])) {
        if (isset($_SESSION['last_activity'])) {
            $inactive_time = time() - $_SESSION['last_activity'];
            
            if ($inactive_time >= INACTIVITY_TIMEOUT) {
                // Catat ke login_logs sebagai auto_logout / idle_logout
                try {
                    require_once __DIR__ . '/database.php';
                    $pdo = getDBConnection();
                    
                    $logStmt = $pdo->prepare("
                        INSERT INTO login_logs (user_id, activity, ip_address, user_agent, created_at)
                        VALUES (:user_id, 'auto_logout', :ip, :ua, NOW())
                    ");
                    $logStmt->execute([
                        'user_id' => $_SESSION['user_id'],
                        'ip'      => $_SERVER['REMOTE_ADDR'] ?? '',
                        'ua'      => $_SERVER['HTTP_USER_AGENT'] ?? ''
                    ]);
                } catch (\Throwable $e) {
                    error_log('Error logging auto_logout: ' . $e->getMessage());
                }

                // Hancurkan session
                destroySession();

                // Redirect ke halaman login dengan pesan timeout jika via HTTP Request biasa
                if (mb_strpos($_SERVER['REQUEST_URI'] ?? '', 'api/') === false) {
                    header("Location: https://lju.co.id/dashboard/?expired=1");
                    exit;
                }
            }
        }
        // Update waktu aktivitas terakhir
        $_SESSION['last_activity'] = time();
    }
}

// Jalankan pengecekan timeout
checkSessionTimeout();

/**
 * Helper: Ambil data user terbaru dengan query langsung ke tabel users di MySQL
 */
function getSessionUser(): array
{
    if (empty($_SESSION['user_id'])) {
        return [
            'id'           => '',
            'nik'          => '',
            'username'     => '',
            'name'         => '',
            'email'        => '',
            'role'         => '',
            'position'     => '',
            'division'     => '',
            'department'   => '',
            'avatar'       => '',
            'photo'        => '',
            'signature'    => '',
            'rfid'         => '',
            'webmail_user' => '',
            'webmail_pass' => '',
        ];
    }

    try {
        require_once __DIR__ . '/database.php';
        $db = getDBConnection();

        $stmt = $db->prepare("
            SELECT id, nik, username, name, email, role, position, division, department, avatar, photo, signature, rfid, webmail_user, webmail_pass 
            FROM users 
            WHERE id = :id 
            LIMIT 1
        ");
        $stmt->execute(['id' => $_SESSION['user_id']]);
        $userRow = $stmt->fetch(\PDO::FETCH_ASSOC);

        if ($userRow) {
            $_SESSION['user_id']      = $userRow['id'];
            $_SESSION['user_nik']     = $userRow['nik'];
            $_SESSION['username']     = $userRow['username'];
            $_SESSION['user_name']    = $userRow['name'];
            $_SESSION['user_email']   = $userRow['email'];
            $_SESSION['role']         = $userRow['role'];
            $_SESSION['position']     = $userRow['position'];
            $_SESSION['division']     = $userRow['division'];
            $_SESSION['department']   = $userRow['department'];
            $_SESSION['avatar']       = $userRow['avatar'];
            $_SESSION['photo']        = $userRow['photo'];
            $_SESSION['signature']    = $userRow['signature'];
            $_SESSION['rfid']         = $userRow['rfid'];
            $_SESSION['webmail_user'] = $userRow['webmail_user'];
            $_SESSION['webmail_pass'] = $userRow['webmail_pass'];
        }
    } catch (\Throwable $e) {
        error_log('Gagal sinkronisasi session user dari database: ' . $e->getMessage());
    }

    return [
        'id'           => $_SESSION['user_id']       ?? '',
        'nik'          => $_SESSION['user_nik']      ?? '',
        'username'     => $_SESSION['username']      ?? '',
        'name'         => $_SESSION['user_name']     ?? '',
        'email'        => $_SESSION['user_email']    ?? '',
        'role'         => $_SESSION['role']          ?? '',
        'position'     => $_SESSION['position']      ?? '',
        'division'     => $_SESSION['division']      ?? '',
        'department'   => $_SESSION['department']    ?? '',
        'avatar'       => $_SESSION['avatar']        ?? '',
        'photo'        => $_SESSION['photo']         ?? '',
        'signature'    => $_SESSION['signature']     ?? '',
        'rfid'         => $_SESSION['rfid']          ?? '',
        'webmail_user' => $_SESSION['webmail_user']  ?? '',
        'webmail_pass' => $_SESSION['webmail_pass']  ?? '',
    ];
}

function isLoggedIn(): bool
{
    return !empty($_SESSION['user_id']) && !empty($_SESSION['username']);
}

function destroySession(): void
{
    $_SESSION = [];
    
    if (ini_get("session.use_cookies")) {
        $params = session_get_cookie_params();
        setcookie(
            session_name(),
            '',
            time() - 42000,
            $params["path"],
            $params["domain"],
            $params["secure"],
            $params["httponly"]
        );
    }
    
    session_destroy();
}